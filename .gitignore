# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code session artifacts
.claude/

# tunnel/dev artifacts
cloudflared.exe
dev.log
cf.log
tunnel.log
body.html
cloudflared.log
cloudflared-err.log
cf_err.log
dev-server.log
dev-server-restart.log
*.pid
start-dev.ps1

# ekte Mustad-data – aldri push til GitHub
lib/tasks.local.ts
lib/widgets.local.ts
lib/incomeForecast.local.ts
lib/tenants.local.ts
lib/companyInfo.local.ts

# ekte rådata brukt til å bygge Redis-snapshots (leietakernavn, beløp) - se
# scripts/refresh-data/README.md for hvordan disse undermappene brukes/fylles ut på nytt
# (README.md selv er IKKE ignorert - kun undermappene med faktiske data)
scripts/refresh-data/*/
scripts/*-snapshot.json
# løse dump-/mellomlagringsfiler direkte i scripts/refresh-data/ (ikke undermapper) -
# kan inneholde ekte leietakernavn (f.eks. dump av booked-tenants-snapshot fra Redis)
scripts/refresh-data/*.json
scripts/refresh-data/*.txt
scripts/refresh-data/*.tsv
scripts/refresh-data/*.csv
!scripts/refresh-data/README.md

.vercel
